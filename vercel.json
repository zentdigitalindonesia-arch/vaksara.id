{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/pemilik",
      "destination": "/#/pemilik",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "/#/admin/screening",
      "permanent": false
    }
  ]
}
